##> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Mapeo de la base de datos de Doctrine
# Para usar MySQL, el formato es:
# mysql://[user]:[password]@[host]:[port]/[database]?serverVersion=[version]

DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/db_name?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Configuración del correo electrónico
# Por ejemplo, para usar un servidor SMTP:
# MAILER_DSN=smtp://user:password@smtp.example.com:587
# Para usar Mailtrap (herramienta de prueba):
# MAILER_DSN=smtp://user:password@smtp.mailtrap.io:2525
###< symfony/mailer ###
# In .env
CORS_ALLOW_ORIGIN="*" ;
MAILER_DSN=smtp://localhost:1025
SUPPORT_EMAIL="prueba@mail.com"
