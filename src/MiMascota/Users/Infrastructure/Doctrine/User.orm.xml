<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\MiMascota\Users\Domain\User" table="users">
        <id name="id" type="string" column="id" length="36" />
        <embedded name="name" class="App\MiMascota\Users\Domain\ValueObject\UserName" use-column-prefix="false" />
        <embedded name="telephone" class="App\MiMascota\Users\Domain\ValueObject\UserTelephone" use-column-prefix="false" />
        <embedded name="email" class="App\MiMascota\Users\Domain\ValueObject\UserEmail" use-column-prefix="false" />
        <one-to-many field="tokens" target-entity="App\MiMascota\Users\Domain\ValueObject\UserToken" mapped-by="user" />
        <embedded name="password" class="App\MiMascota\Users\Domain\ValueObject\UserPassword" use-column-prefix="false" />
        <one-to-many field="preferences" target-entity="App\MiMascota\Users\Domain\ValueObject\UserPreference" mapped-by="user">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>
        <one-to-many field="journals" target-entity="App\MiMascota\Journals\Domain\Journal" mapped-by="user">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>
          <one-to-one field="location" target-entity="App\MiMascota\Locations\Domain\UserLocation" mapped-by="user">
              <cascade>
                  <cascade-persist/>
                  <cascade-remove/>
              </cascade>
          </one-to-one>
        <one-to-one field="image" target-entity="App\MiMascota\Images\Domain\UserImage" mapped-by="user">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-one>
        <one-to-many field="posts" target-entity="App\MiMascota\Posts\Domain\Post" mapped-by="user"/>
        <embedded name="timeStamp" class="App\MiMascota\Shared\Domain\ValueObject\TimeStamp" use-column-prefix="false"/>
        <embedded name="softDelete" class="App\MiMascota\Shared\Domain\ValueObject\SoftDelete" use-column-prefix="false"/>

    </entity>

</doctrine-mapping>
