<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\MiMascota\Users\Domain\ValueObject\UserToken" table="user_tokens"  >
        <id name="id" type="string" column="id" length="36" />
        <many-to-one field="user" target-entity="App\MiMascota\Users\Domain\User" inversed-by="tokens"/>
        <field name="value" column="token" length="255" nullable="true" />
        <field name="createdAt" column="createdAt" type="datetime"/>
        <field name="expireAt" column="expires_at" type="datetime" nullable="true" />
    </entity>
</doctrine-mapping>
