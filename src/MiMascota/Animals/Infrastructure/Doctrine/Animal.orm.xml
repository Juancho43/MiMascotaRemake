<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\MiMascota\Animals\Domain\Animal" table="animals">
        <id name="id" type="string" column="id" length="36" />
        <embedded name="name" class="App\MiMascota\Animals\Domain\ValueObject\AnimalName" use-column-prefix="false"/>
        <embedded name="description" class="App\MiMascota\Animals\Domain\ValueObject\AnimalDescription" use-column-prefix="false"/>
        <embedded name="color" class="App\MiMascota\Animals\Domain\ValueObject\AnimalColor" use-column-prefix="false"/>
        <embedded name="size" class="App\MiMascota\Animals\Domain\ValueObject\AnimalSize" use-column-prefix="false"/>
        <embedded name="breed" class="App\MiMascota\Animals\Domain\ValueObject\AnimalBreed" use-column-prefix="false"/>
        <embedded name="gender" class="App\MiMascota\Animals\Domain\ValueObject\AnimalGender" use-column-prefix="false"/>
        <embedded name="birthDate" class="App\MiMascota\Animals\Domain\ValueObject\AnimalBirthDate" use-column-prefix="false"/>
        <embedded name="weight" class="App\MiMascota\Animals\Domain\ValueObject\AnimalWeight" use-column-prefix="false"/>

         <one-to-many field="posts" target-entity="App\MiMascota\Posts\Domain\Post" mapped-by="animal"/>
        <one-to-one field="journal" target-entity="App\MiMascota\Journals\Domain\Journal" inversed-by="animal" />
        <one-to-many field="images" target-entity="App\MiMascota\Images\Domain\AnimalImage" mapped-by="animal">
            <cascade>
                <cascade-all/>
            </cascade>
        </one-to-many>
        <embedded name="timeStamp" class="App\MiMascota\Shared\Domain\ValueObject\TimeStamp" use-column-prefix="false"/>
        <embedded name="softDelete" class="App\MiMascota\Shared\Domain\ValueObject\SoftDelete" use-column-prefix="false"/>
    </entity>

</doctrine-mapping>
