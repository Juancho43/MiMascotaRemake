<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\MiMascota\Journals\Domain\Journal" table="journals">
        <id name="id" type="string" column="id" length="36" />

        <embedded name="slug" class="App\MiMascota\Journals\Domain\ValueObject\JournalSlug" use-column-prefix="false"/>

     <many-to-one field="user" target-entity="App\MiMascota\Users\Domain\User" inversed-by="journals">
         <join-column name="user_id" />
         <cascade>
             <cascade-persist />
         </cascade>
     </many-to-one>
        <one-to-one field="animal" target-entity="App\MiMascota\Animals\Domain\Animal" inversed-by="journal" orphan-removal="true" mapped-by="journal">
            <cascade>
                <cascade-persist />
                <cascade-remove />
            </cascade>
        </one-to-one>
     <one-to-many field="entries" target-entity="App\MiMascota\Entries\Domain\Entry" mapped-by="journal" orphan-removal="true">
           <cascade>
               <cascade-persist />
               <cascade-remove />
           </cascade>
       </one-to-many>
        <embedded name="timeStamp" class="App\MiMascota\Shared\Domain\ValueObject\TimeStamp" use-column-prefix="false"/>
        <embedded name="softDelete" class="App\MiMascota\Shared\Domain\ValueObject\SoftDelete" use-column-prefix="false"/>
    </entity>

</doctrine-mapping>
