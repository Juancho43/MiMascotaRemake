<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\MiMascota\Locations\Domain\Location" table="locations">
        <id name="id" type="string" column="id" length="36" />

        <embedded name="city" class="App\MiMascota\Locations\Domain\ValueObject\LocationCity" use-column-prefix="false"/>
        <embedded name="country" class="App\MiMascota\Locations\Domain\ValueObject\LocationCountry" use-column-prefix="false"/>
        <embedded name="latitude" class="App\MiMascota\Locations\Domain\ValueObject\LocationLatitude" use-column-prefix="false"/>
        <embedded name="longitude" class="App\MiMascota\Locations\Domain\ValueObject\LocationLongitude" use-column-prefix="false"/>

        <embedded name="slug" class="App\MiMascota\Locations\Domain\ValueObject\LocationSlug" use-column-prefix="false"/>
        <embedded name="timeStamp" class="App\MiMascota\Shared\Domain\ValueObject\TimeStamp" use-column-prefix="false"/>
        <embedded name="softDelete" class="App\MiMascota\Shared\Domain\ValueObject\SoftDelete" use-column-prefix="false"/>
    </entity>

</doctrine-mapping>
