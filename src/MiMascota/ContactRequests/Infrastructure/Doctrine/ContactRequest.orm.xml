<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\MiMascota\ContactRequests\Domain\ContactRequest" table="contact_requests">
        <id name="id" type="string" column="id" length="36" />
       <many-to-one field="requester" target-entity="App\MiMascota\Users\Domain\User">
           <join-column name="requester_id" referenced-column-name="id" nullable="false"/>
       </many-to-one>
       <many-to-one field="owner" target-entity="App\MiMascota\Users\Domain\User">
           <join-column name="owner_id" referenced-column-name="id" nullable="false"/>
       </many-to-one>
       <many-to-one field="post" target-entity="App\MiMascota\Posts\Domain\Post">
           <join-column name="post_id" referenced-column-name="id" nullable="false"/>
       </many-to-one>
       <embedded name="status" class="App\MiMascota\ContactRequests\Domain\ContactRequestStatus" use-column-prefix="false"/>


        <embedded name="timeStamp" class="App\MiMascota\Shared\Domain\ValueObject\TimeStamp" use-column-prefix="false"/>


    </entity>

</doctrine-mapping>
