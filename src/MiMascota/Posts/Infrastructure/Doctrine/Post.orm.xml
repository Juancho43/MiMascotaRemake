<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\MiMascota\Posts\Domain\Post" table="posts">
        <id name="id" type="string" column="id" length="36" />
        <field name="title" column="title" length="100" />
        <field name="slug" column="slug" length="100" />
        <field name="content" column="content" length="200" />
        <many-to-one field="forum" target-entity="App\MiMascota\Forums\Domain\Forum" inversed-by="posts"/>
        <many-to-one field="user" target-entity="App\MiMascota\Users\Domain\User" inversed-by="posts"/>
        <many-to-one field="animal" target-entity="App\MiMascota\Animals\Domain\Animal" inversed-by="posts"/>
        <many-to-one field="location" target-entity="App\MiMascota\Locations\Domain\Location"/>
        <embedded name="timeStamp" class="App\MiMascota\Shared\Domain\ValueObject\TimeStamp" use-column-prefix="false"/>
        <embedded name="softDelete" class="App\MiMascota\Shared\Domain\ValueObject\SoftDelete" use-column-prefix="false" />
    </entity>

</doctrine-mapping>
