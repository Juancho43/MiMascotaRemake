<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\MiMascota\Entries\Domain\Entry" table="entries">
        <id name="id" type="string" column="id" length="36" />
        <embedded name="title" class="App\MiMascota\Entries\Domain\ValueObject\EntryTitle" use-column-prefix="false"/>
        <embedded name="content" class="App\MiMascota\Entries\Domain\ValueObject\EntryContent" use-column-prefix="false"/>
        <embedded name="date" class="App\MiMascota\Entries\Domain\ValueObject\EntryDate" use-column-prefix="false"/>
        <many-to-one field="journal" target-entity="App\MiMascota\Journals\Domain\Journal" inversed-by="entries">
            <join-column name="journal_id" nullable="false" />
        </many-to-one>
        <one-to-many field="images" target-entity="App\MiMascota\Images\Domain\EntryImage" mapped-by="entry" orphan-removal="true">
            <cascade>
                <cascade-all/>
            </cascade>
        </one-to-many>
        <embedded name="timeStamp" class="App\MiMascota\Shared\Domain\ValueObject\TimeStamp" use-column-prefix="false"/>
        <embedded name="softDelete" class="App\MiMascota\Shared\Domain\ValueObject\SoftDelete" use-column-prefix="false"/>
    </entity>

</doctrine-mapping>
